+import { spawn } from "node:child_process";
+import { EventEmitter } from "node:events";
+import { chunkAudio, convertPcmToMulaw8k } from "@openclaw/voice-call/src/telephony-audio.js";
+import { computeRms } from "./shared/audio.js";
+
+function downmixToMono(frame: Buffer, channels: number): Buffer {
+  if (channels <= 1) return frame;
+  const samples = Math.floor(frame.length / 2);
+  const frames = Math.floor(samples / channels);
+  if (frames <= 0) return Buffer.alloc(0);
+  const out = Buffer.alloc(frames * 2);
+  for (let i = 0; i < frames; i++) {
+    let sum = 0;
+    for (let c = 0; c < channels; c++) {
+      const idx = (i * channels + c) * 2;
+      sum += frame.readInt16LE(idx);
+    }
+    const avg = Math.round(sum / channels);
+    out.writeInt16LE(avg, i * 2);
+  }
+  return out;
+}
+
+export type VoiceCallCaptureConfig = {
+  device: string;
+  sampleRate: number;
+  channels: number;
+  frameMs: number;
+  energyLogIntervalMs: number;
+};
+
+const MULAW_CHUNK_BYTES = 160; // 20ms at 8kHz mu-law
+
+export class VoiceCallCapture extends EventEmitter {
+  private config: VoiceCallCaptureConfig;
+  private proc: ReturnType<typeof spawn> | null = null;
+  private stopped = false;
+  private restartTimer: NodeJS.Timeout | null = null;
+  private restartDelayMs = 500;
+  private lastFrameAt = 0;
+  private stallTimer: NodeJS.Timeout | null = null;
+  private energyLogTimer: NodeJS.Timeout | null = null;
+  private energyLogSamples = 0;
+  private energyLogSum = 0;
+  private pendingPcm: Buffer = Buffer.alloc(0);
+  private pendingMulaw: Buffer = Buffer.alloc(0);
+  private frameMs: number;
+
+  constructor(config: VoiceCallCaptureConfig) {
+    super();
+    this.config = config;
+    this.frameMs = Math.max(5, config.frameMs);
+  }
+
+  start(): void {
+    if (this.proc) {
+      return;
+    }
+
+    this.lastFrameAt = Date.now();
+    this.startStallTimer();
+    this.startEnergyLogTimer();
+
+    const args = [
+      "-D",
+      this.config.device,
+      "-f",
+      "S16_LE",
+      "-r",
+      String(this.config.sampleRate),
+      "-c",
+      String(this.config.channels),
+      "-t",
+      "raw",
+    ];
+
+    this.proc = spawn("arecord", args, {
+      stdio: ["ignore", "pipe", "pipe"],
+    });
+
+    this.proc.stdout?.on("data", (chunk: Buffer) => {
+      this.lastFrameAt = Date.now();
+      this.handleChunk(chunk);
+    });
+    this.proc.stderr?.on("data", (chunk: Buffer) => {
+      this.emit("log", chunk.toString());
+    });
+    this.proc.on("exit", (code) => {
+      if (!this.stopped) {
+        this.emit("error", new Error(`arecord exited with ${code ?? "unknown"}`));
+        this.scheduleRestart();
+      }
+    });
+  }
+
+  stop(): void {
+    this.stopped = true;
+    this.clearRestartTimer();
+    this.clearStallTimer();
+    this.clearEnergyLogTimer();
+    this.pendingPcm = Buffer.alloc(0);
+    this.pendingMulaw = Buffer.alloc(0);
+    if (this.proc) {
+      this.proc.kill("SIGTERM");
+      this.proc = null;
+    }
+  }
+
+  isRunning(): boolean {
+    return Boolean(this.proc);
+  }
+
+  private handleChunk(chunk: Buffer): void {
+    if (chunk.length === 0) {
+      return;
+    }
+    this.pendingPcm = this.pendingPcm.length
+      ? Buffer.concat([this.pendingPcm, chunk])
+      : chunk;
+
+    const frameBytes = Math.floor(
+      (this.config.sampleRate * this.config.channels * 2 * this.frameMs) / 1000,
+    );
+    if (frameBytes <= 0) {
+      return;
+    }
+
+    while (this.pendingPcm.length >= frameBytes) {
+      const frame = this.pendingPcm.subarray(0, frameBytes);
+      this.pendingPcm = this.pendingPcm.subarray(frameBytes);
+      const monoFrame = downmixToMono(frame, this.config.channels);
+      if (!monoFrame.length) {
+        continue;
+      }
+      this.emit("pcm", monoFrame);
+
+      if (this.config.energyLogIntervalMs > 0) {
+        const rms = computeRms(monoFrame);
+        this.energyLogSamples += 1;
+        this.energyLogSum += rms;
+      }
+
+      const muLaw = convertPcmToMulaw8k(monoFrame, this.config.sampleRate);
+      if (muLaw.length) {
+        this.pendingMulaw = this.pendingMulaw.length
+          ? Buffer.concat([this.pendingMulaw, muLaw])
+          : muLaw;
+        const flushLength =
+          this.pendingMulaw.length - (this.pendingMulaw.length % MULAW_CHUNK_BYTES);
+        if (flushLength > 0) {
+          const flush = this.pendingMulaw.subarray(0, flushLength);
+          this.pendingMulaw = this.pendingMulaw.subarray(flushLength);
+          for (const chunk of chunkAudio(flush, MULAW_CHUNK_BYTES)) {
+            this.emit("mulaw", chunk);
+          }
+        }
+      }
+    }
+  }
+
+  private startStallTimer(): void {
+    if (this.stallTimer) {
+      return;
+    }
+    const checkIntervalMs = Math.max(500, this.frameMs * 4);
+    const stallThresholdMs = Math.max(2000, this.frameMs * 50);
+    this.stallTimer = setInterval(() => {
+      if (this.stopped) {
+        return;
+      }
+      if (!this.proc) {
+        return;
+      }
+      if (Date.now() - this.lastFrameAt > stallThresholdMs) {
+        this.emit("error", new Error("arecord stalled"));
+        this.scheduleRestart();
+      }
+    }, checkIntervalMs);
+  }
+
+  private clearStallTimer(): void {
