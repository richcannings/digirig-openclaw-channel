+export function computeRms(frame: Buffer): number {
+  if (frame.length < 2) {
+    return 0;
+  }
+  let sum = 0;
+  for (let i = 0; i < frame.length; i += 2) {
+    const sample = frame.readInt16LE(i) / 32768;
+    sum += sample * sample;
+  }
+  const mean = sum / (frame.length / 2);
+  return Math.sqrt(mean);
+}
