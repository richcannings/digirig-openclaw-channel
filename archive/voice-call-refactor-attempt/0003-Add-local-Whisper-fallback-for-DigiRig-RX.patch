+function isLikelyGarbledTranscript(text: string): boolean {
+  const trimmed = text.trim();
+  if (!trimmed) return true;
+  const alnum = (trimmed.match(/[a-z0-9]/gi) ?? []).length;
+  if (alnum < 2) return true;
+  const wordCount = trimmed.split(/\s+/).filter(Boolean).length;
+  if (wordCount === 1 && trimmed.length <= 2) return true;
+  if (/(.)\1{5,}/.test(trimmed)) return true;
+  return false;
+}
+
+type LocalWhisperOptions = {
+  pcm16: Buffer;
+  inputSampleRate: number;
+  model: string;
+  command: string;
+  args: string[];
+  language?: string;
+  timeoutMs: number;
+  logger: ChannelGatewayStartContext<DigirigConfig>["log"] | null;
+  sessionId: number;
+};
+
+async function transcribeWithLocalWhisper(opts: LocalWhisperOptions): Promise<string> {
+  if (!opts.pcm16.length) {
+    return "";
+  }
+  const tempDir = await fs.mkdtemp(join(tmpdir(), "digirig-whisper-"));
+  const wavPath = join(tempDir, `rx-${opts.sessionId}.wav`);
+  const wavPcm = resamplePcm16MonoLinear(opts.pcm16, opts.inputSampleRate, 16000);
+  const wavData = buildPcm16MonoWav(wavPcm, 16000);
+  const base = basename(wavPath, ".wav");
+  const outPath = join(tempDir, `${base}.txt`);
+  try {
+    await fs.writeFile(wavPath, wavData);
+    const args = [
+      wavPath,
+      ...opts.args,
+      "--model",
+      opts.model,
+      "--output_format",
+      "txt",
+      "--output_dir",
+      tempDir,
+    ];
+    if (opts.language && opts.language.trim()) {
+      args.push("--language", opts.language.trim());
+    }
+    const run = await runCommandWithOutput(opts.command, args, opts.timeoutMs);
+    if (run.exitCode !== 0) {
+      opts.logger?.warn?.(
+        `[digirig] local whisper failed (exit=${run.exitCode}) stderr=${run.stderr.trim() || "<none>"}`,
+      );
+      return "";
+    }
+    const text = await fs.readFile(outPath, "utf8").catch(() => "");
+    if (!text.trim()) {
+      opts.logger?.warn?.("[digirig] local whisper produced empty transcript");
+      return "";
+    }
+    opts.logger?.info?.("[digirig] local whisper transcript ready");
+    return normalizeSttText(text);
+  } catch (err) {
+    opts.logger?.warn?.(`[digirig] local whisper error: ${String(err)}`);
+    return "";
+  } finally {
+    await fs.rm(tempDir, { recursive: true, force: true }).catch(() => undefined);
+  }
+}
+
+async function runCommandWithOutput(
+  cmd: string,
+  args: string[],
+  timeoutMs: number,
+): Promise<{ exitCode: number | null; stdout: string; stderr: string }> {
+  return await new Promise((resolve, reject) => {
+    const proc = spawn(cmd, args);
+    let stdout = "";
+    let stderr = "";
+    let done = false;
+    const timeout = setTimeout(() => {
+      if (!done) {
+        proc.kill("SIGKILL");
+      }
+    }, Math.max(1000, timeoutMs));
+    proc.stdout?.on("data", (chunk) => {
+      stdout += String(chunk);
+    });
+    proc.stderr?.on("data", (chunk) => {
+      stderr += String(chunk);
+    });
+    proc.on("error", (err) => {
+      done = true;
+      clearTimeout(timeout);
+      reject(err);
+    });
+    proc.on("exit", (code) => {
+      done = true;
+      clearTimeout(timeout);
+      resolve({ exitCode: code, stdout, stderr });
+    });
+  });
+}
+
+function resamplePcm16MonoLinear(input: Buffer, srcRate: number, destRate: number): Buffer {
+  if (srcRate <= 0 || destRate <= 0 || input.length < 2) {
+    return Buffer.alloc(0);
+  }
+  if (srcRate === destRate) {
+    return Buffer.from(input);
+  }
+  const inSamples = Math.floor(input.length / 2);
+  if (inSamples <= 1) {
+    return Buffer.from(input);
+  }
+  const outSamples = Math.max(1, Math.round((inSamples * destRate) / srcRate));
+  const out = Buffer.alloc(outSamples * 2);
+  const lastIn = inSamples - 1;
+  for (let i = 0; i < outSamples; i += 1) {
+    const pos = outSamples <= 1 ? 0 : (i * lastIn) / (outSamples - 1);
+    const lo = Math.floor(pos);
+    const hi = Math.min(lastIn, lo + 1);
+    const frac = pos - lo;
+    const s0 = input.readInt16LE(lo * 2);
+    const s1 = input.readInt16LE(hi * 2);
+    const sample = Math.max(-32768, Math.min(32767, Math.round(s0 + (s1 - s0) * frac)));
+    out.writeInt16LE(sample, i * 2);
+  }
+  return out;
+}
+
+function buildPcm16MonoWav(pcm16: Buffer, sampleRate: number): Buffer {
+  const blockAlign = 2;
+  const byteRate = sampleRate * blockAlign;
+  const dataSize = pcm16.length;
+  const buffer = Buffer.alloc(44 + dataSize);
+  buffer.write("RIFF", 0);
+  buffer.writeUInt32LE(36 + dataSize, 4);
+  buffer.write("WAVE", 8);
+  buffer.write("fmt ", 12);
+  buffer.writeUInt32LE(16, 16);
+  buffer.writeUInt16LE(1, 20);
+  buffer.writeUInt16LE(1, 22);
+  buffer.writeUInt32LE(sampleRate, 24);
+  buffer.writeUInt32LE(byteRate, 28);
+  buffer.writeUInt16LE(blockAlign, 32);
+  buffer.writeUInt16LE(16, 34);
+  buffer.write("data", 36);
+  buffer.writeUInt32LE(dataSize, 40);
+  pcm16.copy(buffer, 44);
+  return buffer;
+}
