    "test:rx-meter": "node scripts/rx-meter.cjs",
    "doctor": "node scripts/doctor.cjs",
    "setup": "node scripts/setup-wizard.cjs"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "serialport": "^12.0.0",
    "wavefile": "^11.0.0",
