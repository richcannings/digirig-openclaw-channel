{
  "name": "@openclaw/digirig",
  "version": "0.6.0",
  "description": "An OpenClaw channel plugin that connects amateur radio to an AI assistant via the DigiRig Mobile USB interface.",
  "license": "MIT",
  "author": "Rich Cannings",
  "repository": {
    "type": "git",
    "url": "https://github.com/richcannings/digirig-openclaw-channel"
  },
  "private": true,
  "type": "module",
  "main": "index.ts",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:smoke": "./scripts/self-test.sh",
